# MediSync Frontend 환경변수 예시
# 빌드 시 (npm run build) Vite 가 .env.production 또는 .env 를 자동 인식.
# 개발 시 (npm run dev) 는 .env 또는 .env.development 사용.

# API 기본 URL (백엔드)
# dev: 비워두면 vite.config.js 의 proxy(/api → localhost:8000) 가 동작.
# prod: VITE_API_URL=https://your-domain.com  ← 같은 도메인이면 비워둬도 됨 (상대경로 fetch)
VITE_API_URL=http://localhost:8000
