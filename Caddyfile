# MediSync Caddyfile — HTTPS 자동 발급(Let's Encrypt) + 라우팅
# DOMAIN 환경변수는 docker-compose.yml 에서 주입.

{$DOMAIN} {
	# /api/*, /auth/*, /health 백엔드로 프록시 (WS 포함, Caddy 가 자동 upgrade)
	@backend path /api/* /auth/* /health
	reverse_proxy @backend api:8000

	# 그 외는 프론트(nginx) — SPA fallback 은 nginx 측 try_files 가 처리
	reverse_proxy frontend:80

	# 압축
	encode gzip zstd

	# 보안 헤더
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# 업로드 한도 (보고서/메모 첨부 대비)
	request_body {
		max_size 10MB
	}
}
